# ===================== 模板 =====================

# Boss 直聘 MCP 服务器地址
MCP_SERVER_URL=http://127.0.0.1:8000

# 主 AI 配置(OpenAI 兼容 API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# 备用 AI 配置(主 AI 异常时自动切换)
BACKUP_AI_API_KEY=
BACKUP_AI_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
BACKUP_AI_MODEL=hunyuan-turbos-latest
BACKUP_AI_ENABLE_ENHANCEMENT=true

# 爬取参数
REQUEST_DELAY=1.5
MAX_RETRY=3
MAX_PAGES_PER_SEARCH=5

# 数据存储目录(相对项目根)
DATA_DIR=data
OUTPUT_DIR=output
LAST_SEARCH_TIME=

# Boss 直聘登录 Cookie / BST(由 MCP 登录或前端登录后自动写入,可留空)
BOSS_COOKIE=
BOSS_BST=

# 可选:Web 应用入口
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=true
EXPORT_DEFAULT_FORMAT=pdf

# 可选:Flask 会话密钥(默认仅供本地开发,生产环境请覆盖)
# CAREERAI_SECRET_KEY=
